# =============================================================================
# Stratix AI Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your environment.
# NEVER commit the actual .env file or real secrets to version control.
# =============================================================================

# Flask Application Settings
SECRET_KEY=your_secure_random_64_character_hex_string_here
FLASK_ENV=development
SESSION_COOKIE_SECURE=False

# Database Configuration
# Local Development (SQLite):
DATABASE_URL=sqlite:///database.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://db_user:db_password@db_host:5432/db_name

# PostgreSQL Connection Pool Configuration (Production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# External AI & Market Intelligence APIs
GROQ_API_KEY=
OPENROUTER_API_KEY=
NEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Google OAuth (GIS)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail & OTP Settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# LLM Gateway & Fallback Configuration
LLM_PRIMARY_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODELS=anthropic/claude-3.5-haiku,google/gemini-2.5-flash,openai/gpt-4o
LLM_TIMEOUT=12
LLM_MAX_RETRIES=1
